{
  "name": "prefix-d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p server && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p server",
    "server:dev": "wrangler dev -c server/wrangler.jsonc --var ALLOWED_COUNTRIES:*",
    "server:deploy": "wrangler deploy -c server/wrangler.jsonc"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "22.18.0",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
